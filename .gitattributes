# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Windows scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.glb binary
*.gltf binary
*.bin binary
*.zip binary
