# ==========================================
# IntelliClass AI Polyglot Monorepo .gitignore
# ==========================================

# Dependencies
node_modules/
.pnpm-store/
.pnpm-debug.log*

# Python virtual environment & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Next.js Build & Cache
.next/
out/
*.tsbuildinfo
.turbo/

# Environment files & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local
*.pem
*.key

# Git migration backups
*.git.bak/
.git.bak

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Archives & Large Files
*.zip
*.tar.gz
*.rar
*.7z
zips/


# 3D Assets & Models (Hosted on Supabase Storage)
*.glb
*.gltf
*.fbx
*.obj
*.blend
**/public/models/
**/public/animations/
**/public/generated/


# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
