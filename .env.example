# ==============================================================================
# IntelliClass AI Polyglot Monorepo — Environment Variables Blueprint
# ==============================================================================
#
# This file documents all environment variables used across the 3 sub-services:
# 1. Frontend:     model-next/.env.local
# 2. AI Backend:   ai-backend/.env
# 3. HeadTTS:      HeadTTS/.env (optional; defaults to port 8882)
#
# Copy values to the respective local environment files for local development.

# ==============================================================================
# 1. Frontend (model-next/.env.local)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_AI_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_TTS_URL=http://localhost:8882
GEMINI_API_KEY=AIzaSy...

# ==============================================================================
# 2. AI Backend (ai-backend/.env)
# ==============================================================================
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
GEMINI_API_KEY=AIzaSy...
PORT=8000

# ==============================================================================
# 3. HeadTTS Service (HeadTTS/.env)
# ==============================================================================
PORT=8882
